# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Administrative email for backoffice login (defaults to admin@pagora.pt)
ADMIN_EMAIL=

# ADMIN_PASSWORD: Secret password used for admin access verification on the server
ADMIN_PASSWORD=

# PAYMENT_WEBHOOK_SECRET: Secret used to verify HMAC signatures of payment webhooks
PAYMENT_WEBHOOK_SECRET=

# VITE_PLUS_CHECKOUT_URL: External checkout URL for the PLUS plan (e.g. Stripe, Ifthenpay, LemonSqueezy)
VITE_PLUS_CHECKOUT_URL=

# VITE_PRO_CHECKOUT_URL: External checkout URL for the PRO plan (e.g. Stripe, Ifthenpay, LemonSqueezy)
VITE_PRO_CHECKOUT_URL=

# RESEND_API_KEY: Secret API key for sending transactional emails via Resend (https://resend.com)
RESEND_API_KEY=

# EMAIL_FROM: Default sender address (e.g. "PAGORA <onboarding@resend.dev>" or "PAGORA <noreply@pagora.pt>")
EMAIL_FROM=

